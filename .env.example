# ── Ambiente ─────────────────────────────────────────────────────────────
# development | test | production (production recusa memória, e-mail no console, CORS "*" e APP_URL http)
NODE_ENV=development
PORT=3333

# ── Persistência ─────────────────────────────────────────────────────────
# prisma  = Postgres (DATABASE_URL obrigatória)
# memoria = tudo na RAM, some ao reiniciar — sobe a API sem banco nenhum
PERSISTENCIA=prisma
# com o docker-compose deste repositório: postgresql://dindin:dindin@localhost:5432/dindin?schema=public
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/dindin?schema=public"

# ── HTTP ─────────────────────────────────────────────────────────────────
# origens do frontend, separadas por vírgula
CORS_ORIGIN=http://localhost:3000
# atrás de proxy/load balancer: quantos saltos confiar (afeta IP e rate limit)
TRUST_PROXY=0
LOG_REQUESTS=true
# limite por IP em POST /auth/link-magico (5), /auth/verificar (20) e /descadastrar (20) a cada 15 min.
# Sem valor: ligado — menos com NODE_ENV=test. O contador fica na memória do processo:
# com mais de uma instância, cada uma conta separado.
RATE_LIMIT=true

# ── Autenticação (link mágico, sem senha) ────────────────────────────────
# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSAO_DIAS=30
LINK_MAGICO_MINUTOS=15
# sem reenvio de link pro mesmo e-mail antes disso (0 a 3600; produção exige pelo menos 60)
LINK_REENVIO_SEGUNDOS=60
# onde o frontend roda: base dos links enviados por e-mail
APP_URL=http://localhost:3000

# ── E-mail ───────────────────────────────────────────────────────────────
# console = imprime o e-mail no terminal (pegue o link mágico ali)
EMAIL_PROVEDOR=console
EMAIL_REMETENTE="dindin <nao-responda@dindin.app>"
RESEND_API_KEY=
