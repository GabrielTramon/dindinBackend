# ── Ambiente ─────────────────────────────────────────────────────────────
# development | test | production (production recusa memória, e-mail no console, CORS "*" e APP_URL http)
NODE_ENV=development
PORT=3701

# ── Persistência ─────────────────────────────────────────────────────────
# prisma  = Postgres (DATABASE_URL obrigatória)
# memoria = tudo na RAM, some ao reiniciar — sobe a API sem banco nenhum
PERSISTENCIA=prisma
# com o docker-compose deste repositório: postgresql://dindin:dindin@localhost:5432/dindin?schema=public
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/dindin?schema=public"

# ── HTTP ─────────────────────────────────────────────────────────────────
# origens do frontend, separadas por vírgula
CORS_ORIGIN=http://localhost:3700
# atrás de proxy/load balancer: quantos saltos confiar (afeta IP e rate limit)
TRUST_PROXY=0
LOG_REQUESTS=true
# limite por IP a cada 15 min, um contador por rota: POST /auth/cadastrar (10), /auth/entrar (10),
# /auth/esqueci-senha (5), /auth/redefinir-senha (20), /auth/verificar (20), /me/senha (10) e
# /descadastrar (20). Sem valor: ligado — menos com NODE_ENV=test. O contador fica na memória
# do processo: com mais de uma instância, cada uma conta separado.
RATE_LIMIT=true

# ── Conta (e-mail + senha) ───────────────────────────────────────────────
# A senha é guardada só como hash scrypt. Os links que vão por e-mail ("Confirme seu e-mail"
# e "Criar uma senha nova") levam o token no fragmento (#token=) e o banco guarda o SHA-256.
# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSAO_DIAS=30
# validade do link "Criar uma senha nova" (Esqueci a senha), em minutos (5 a 1440).
# O nome é do tempo do link mágico e ficou, pra não quebrar o .env de ninguém.
LINK_MAGICO_MINUTOS=15
# validade do link "Confirme seu e-mail", mandado no cadastro, em horas (1 a 168)
LINK_CONFIRMACAO_HORAS=48
# sem reenvio de link pro mesmo e-mail antes disso (0 a 3600; produção exige pelo menos 60)
LINK_REENVIO_SEGUNDOS=60
# onde o frontend roda: base dos links enviados por e-mail (/entrar#token=, /redefinir-senha#token=)
APP_URL=http://localhost:3700

# ── E-mail ───────────────────────────────────────────────────────────────
# console = imprime o e-mail no terminal (pegue ali o link de confirmação ou de senha nova)
EMAIL_PROVEDOR=console
EMAIL_REMETENTE="dindin <nao-responda@dindin.app>"
RESEND_API_KEY=
