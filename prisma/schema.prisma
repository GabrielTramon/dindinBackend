generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// dindin — planejador financeiro
//
// Nada disso é usado pelo app ainda: no v1 o plano vive no localStorage do
// navegador e não existe cadastro. O banco entra na fase do check-in mensal,
// quando a pessoa deixa o e-mail pra receber o lembrete.
//
// Por isso não há senha em lugar nenhum: a identidade é o e-mail mais um
// token de link mágico.
//
// Os `slug` de CategoriaGastoFixo são contrato com o frontend
// (dindinFrontend/src/domain/categorias.ts). Slug publicado não muda.
// ============================================================================

// ----------------------------------------------------------------------------
// Identidade
// ----------------------------------------------------------------------------

model Subscriber {
  id            String    @id @default(uuid())
  email         String    @unique
  /// SHA-256 do token do link mágico — o token em si só existe no e-mail.
  /// Rotacionado a cada envio e trocado por um valor inutilizável depois de usado.
  token         String    @unique
  tokenExpiraEm DateTime? @map("token_expira_em")

  /// preenchido no primeiro link mágico usado; sem isso a pessoa nunca recebe
  /// o e-mail mensal — o endereço pode ter sido digitado por outra pessoa
  emailVerificadoEm DateTime? @map("email_verificado_em")

  /// descadastro em um clique: mantém o histórico, para de enviar
  ativo Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  perfil     Profile?
  categorias CategoriaGastoFixo[]
  planos     Plan[]
  metas      Goal[]
  checkIns   CheckIn[]
  grupos     Grupo[]

  @@map("subscribers")
}

// ----------------------------------------------------------------------------
// Perfil — o estado atual das respostas
// ----------------------------------------------------------------------------

enum TipoRenda {
  CLT
  PJ
  INFORMAL

  @@map("tipo_renda")
}

enum Moradia {
  PAIS
  ALUGUEL
  DIVIDIDO
  PROPRIA
  FINANCIADA

  @@map("moradia")
}

enum RendaInformada {
  BRUTA
  LIQUIDA

  @@map("renda_informada")
}

enum Ritmo {
  LEVE
  EQUILIBRADO
  ACELERADO

  @@map("ritmo")
}

/// o slug do catálogo do motor (metas-catalogo.ts); publicado, não muda
enum MetaTipo {
  CARRO
  CASA
  LIBERDADE
  EMERGENCIA
  VIAGEM
  ESTUDOS
  OUTRO

  @@map("meta_tipo")
}

model Profile {
  subscriberId String     @id @map("subscriber_id")
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  /// SEMPRE o líquido: é o número que o motor usa. Quando a pessoa informa o
  /// bruto, aqui entra o líquido calculado no momento da resposta.
  rendaMensal Decimal @map("renda_mensal") @db.Decimal(12, 2)

  // ── Como a renda foi informada ──────────────────────────────────────────
  // Tudo nulo de propósito: quem respondeu antes destas colunas informou o
  // líquido e não escolheu ritmo. NULL é o único valor que distingue "não
  // escolheu" de "escolheu o padrão" — e default aqui mudaria o snapshot de
  // todo plano já gravado, criando uma versão nova pra base inteira.
  rendaInformada    RendaInformada? @map("renda_informada")
  /// o bruto informado, só como registro; o líquido nunca é recalculado a
  /// partir dele (a tabela do imposto muda todo ano e o passado mudaria junto)
  salarioBruto      Decimal?        @map("salario_bruto") @db.Decimal(12, 2)
  dependentes       Int?
  /// competência da tabela que gerou o líquido, ex.: "2026-01"
  competenciaTabela String?         @map("competencia_tabela")
  /// quanto do que sobra vira aporte; nulo = equilibrado
  ritmo             Ritmo?

  // ── Meta principal ──────────────────────────────────────────────────────
  // Uma só, escolhida no questionário. Fica em colunas do perfil (e não numa
  // tabela) porque é exatamente uma por pessoa e viaja junto com o perfil do
  // motor. As metas do módulo `metas` (com página pública) são outra coisa:
  // lista, com valor acumulado e prazo próprio.
  metaTipo      MetaTipo? @map("meta_tipo")
  /// obrigatório quando o tipo é "outro"
  metaNome      String?   @map("meta_nome")
  metaValorAlvo Decimal?  @map("meta_valor_alvo") @db.Decimal(12, 2)

  /// CLT → reserva de 3 meses; PJ e INFORMAL → 6
  tipoRenda    TipoRenda @map("tipo_renda")
  idade        Int
  moradia      Moradia
  /// aluguel ou parcela + condomínio; 0 quando mora com os pais ou casa quitada
  custoMoradia Decimal   @map("custo_moradia") @db.Decimal(12, 2)
  /// poupança, conta rendendo, dinheiro parado
  guardado     Decimal   @db.Decimal(12, 2)

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  gastosFixos GastoFixo[]
  dividas     Divida[]

  @@map("profiles")
}

// ----------------------------------------------------------------------------
// Catálogo de gastos fixos
//
// Duas origens na mesma tabela:
//   · catálogo global — subscriberId nulo, slug preenchido, semeado na migration
//   · criada pela pessoa — subscriberId preenchido, sem slug, ícone padrão
// ----------------------------------------------------------------------------

enum GrupoCategoria {
  MORADIA
  CASA
  TRANSPORTE
  SAUDE
  EDUCACAO
  PESSOAL
  OUTROS

  @@map("grupo_categoria")
}

model CategoriaGastoFixo {
  id String @id @default(uuid())

  /// contrato com o frontend; nulo nas categorias criadas pela pessoa
  slug  String?        @unique
  nome  String
  grupo GrupoCategoria @default(OUTROS)
  /// nome do componente no lucide-react; ver components/categorias/icone-categoria.tsx
  icone String         @default("Tag")
  /// ordem de exibição dentro do grupo
  ordem Int            @default(999)

  /// nulo = catálogo global (veio da migration)
  subscriberId String?     @map("subscriber_id")
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now()) @map("criado_em")

  gastos GastoFixo[]

  /// ninguém precisa de duas categorias com o mesmo nome
  @@unique([subscriberId, nome])
  @@index([subscriberId])
  @@index([grupo, ordem])
  @@map("categorias_gasto_fixo")
}

model GastoFixo {
  id String @id @default(uuid())

  profileId String  @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [subscriberId], onDelete: Cascade)

  categoriaId String             @map("categoria_id")
  /// Restrict: apagar uma categoria em uso apagaria o gasto junto, silenciosamente
  categoria   CategoriaGastoFixo @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  valor Decimal @db.Decimal(12, 2)

  criadoEm DateTime @default(now()) @map("criado_em")

  /// uma linha por categoria: dois "Mercado" no mesmo perfil é erro de digitação
  @@unique([profileId, categoriaId])
  @@index([profileId])
  @@map("gastos_fixos")
}

// ----------------------------------------------------------------------------
// Dívidas
// ----------------------------------------------------------------------------

enum TipoDivida {
  ROTATIVO
  CHEQUE_ESPECIAL
  EMPRESTIMO
  FINANCIAMENTO
  OUTRA

  @@map("tipo_divida")
}

model Divida {
  id String @id @default(uuid())

  profileId String  @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [subscriberId], onDelete: Cascade)

  tipo      TipoDivida
  saldo     Decimal    @db.Decimal(12, 2)
  /// parcela mensal já paga hoje; nulo quando não há parcela fixa
  parcela   Decimal?   @db.Decimal(12, 2)
  /// ex.: 4.3000 = 430% a.a.; nulo usa o padrão do tipo em config.ts
  taxaAnual Decimal?   @map("taxa_anual") @db.Decimal(8, 4)

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([profileId])
  @@map("dividas")
}

// ----------------------------------------------------------------------------
// Plano — imutável e versionado
//
// Recalcular cria uma versão nova em vez de atualizar: é o histórico que faz
// o check-in mensal mostrar "o que mudou desde o mês passado".
// ----------------------------------------------------------------------------

model Plan {
  id String @id @default(uuid())

  subscriberId String     @map("subscriber_id")
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  versao    Int
  /// perfil congelado no momento do cálculo, no formato de @/domain
  inputSnap Json @map("input_snap")
  /// degrau da cascata, alocações e projeções
  resultado Json

  criadoEm DateTime @default(now()) @map("criado_em")

  @@unique([subscriberId, versao])
  @@index([subscriberId, criadoEm])
  @@map("plans")
}

// ----------------------------------------------------------------------------
// Metas
// ----------------------------------------------------------------------------

model Goal {
  id String @id @default(uuid())

  subscriberId String     @map("subscriber_id")
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  nome         String
  valorAlvo    Decimal  @map("valor_alvo") @db.Decimal(12, 2)
  /// dos dois abaixo, a pessoa informa um e o motor calcula o outro
  aporteMensal Decimal? @map("aporte_mensal") @db.Decimal(12, 2)
  prazoMeses   Int?     @map("prazo_meses")

  acumulado Decimal @default(0) @db.Decimal(12, 2)

  /// /meta/<slug> — compartilhável e indexável quando a pessoa escolhe publicar
  publicSlug String? @unique @map("public_slug")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([subscriberId])
  @@map("goals")
}

// ----------------------------------------------------------------------------
// Check-in mensal — o ritual que faz a pessoa voltar
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
// Organização — como a pessoa reparte o que sobra
//
// Uma árvore de dois níveis, editada como um todo: o PUT substitui tudo numa
// transação. Duas tabelas em vez de uma auto-referenciada porque, no Postgres,
// UNIQUE com coluna nula não impede dois grupos raiz com o mesmo nome — e a
// profundidade de exatamente dois níveis sai de graça no schema.
//
// A chave primária é composta com o dono: o id vem do cliente (é o mesmo do
// localStorage, e é o que faz a árvore sobreviver ao round-trip), então sem o
// dono na chave o id de uma pessoa colidiria com o de outra.
// ----------------------------------------------------------------------------

model Grupo {
  id String

  subscriberId String     @map("subscriber_id")
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  nome  String
  /// nome do componente no lucide-react, do catálogo do motor
  icone String  @default("Tag")
  valor Decimal @db.Decimal(12, 2)

  /// "irá fazer parte da somatória para a meta financeira"
  contaParaMeta    Boolean  @default(false) @map("conta_para_meta")
  /// rendimento informado pela pessoa, ao mês (0.008 = 0,8%); nulo = não rende
  rendimentoMensal Decimal? @map("rendimento_mensal") @db.Decimal(6, 4)
  /// o "Guardar", que o plano preenche; existe um só por pessoa
  doSistema        Boolean  @default(false) @map("do_sistema")

  ordem    Int
  criadoEm DateTime @default(now()) @map("criado_em")

  itens ItemGrupo[]

  @@id([subscriberId, id])
  @@index([subscriberId, ordem])
  @@map("grupos")
}

model ItemGrupo {
  id String

  subscriberId String @map("subscriber_id")
  grupoId      String @map("grupo_id")
  /// o dono vem junto na FK: assim item e grupo nunca discordam de dono
  grupo        Grupo  @relation(fields: [subscriberId, grupoId], references: [subscriberId, id], onDelete: Cascade)

  nome  String
  valor Decimal @db.Decimal(12, 2)
  ordem Int

  @@id([subscriberId, grupoId, id])
  @@index([subscriberId, grupoId, ordem])
  @@map("itens_grupo")
}

model CheckIn {
  id String @id @default(uuid())

  subscriberId String     @map("subscriber_id")
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  /// "2026-09"
  competencia String

  rendaReal    Decimal? @map("renda_real") @db.Decimal(12, 2)
  gastoReal    Decimal? @map("gasto_real") @db.Decimal(12, 2)
  guardadoReal Decimal? @map("guardado_real") @db.Decimal(12, 2)

  enviadoEm    DateTime? @map("enviado_em")
  respondidoEm DateTime? @map("respondido_em")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@unique([subscriberId, competencia])
  @@index([subscriberId])
  @@map("check_ins")
}
